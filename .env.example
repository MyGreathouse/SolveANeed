# ---------------------------------------------------------------------------
# SolveANeed — environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API). The publishable/anon key is safe
# in the browser; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Public site URL (used in emails and redirects). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Require staff (moderators/admins) to have completed MFA (AAL2) to use /admin.
# Must be "true" in production once staff have enrolled an authenticator.
REQUIRE_STAFF_MFA=false

# NOTE: The web app intentionally has NO service-role key. Do not add one here.
# Payments are not implemented; no payment provider keys are needed yet.

# --- Tests only -------------------------------------------------------------
# Disposable Postgres database for policy tests (it is DROPPED on every run).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/solveaneed_test
# End-to-end tests (against a non-production Supabase, e.g. `supabase start`):
# E2E_BASE_URL=http://localhost:3000
# E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# MAILPIT_URL=http://127.0.0.1:54324
